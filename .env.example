# Copy this file to .env and fill in your Firebase project's values.
# These are PUBLIC client config values (safe to ship in the app bundle) —
# they are not secrets. Security is enforced by Firestore rules, not by hiding these.
# Get them from: Firebase Console > Project Settings > General > Your apps > Web app

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to connect to local Firebase Emulators instead of a real
# Firebase project (used for local development/testing, no real account needed).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
